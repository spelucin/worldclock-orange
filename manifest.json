{
  "manifest_version": 3,
  "name": "WorkClock Orange",
  "version": "1.0.0",
  "description": "Compara tu hora local con cualquier ciudad del mundo: diferencia horaria, horario laboral y múltiples ubicaciones guardadas. Multilingüe (EN/ES/PT).",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WorkClock Orange",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}